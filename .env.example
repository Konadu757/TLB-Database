# Supabase (required for live data)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_sb_publishable_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Set to 0 to force localStorage-only domain store
VITE_TLB_USE_SUPABASE=1

# Optional: override built-in /api/invite-email with an external mail URL.
# Body JSON: { "to", "name", "inviteCode", "inviteLink", "role?" }
# Prefer the built-in route + RESEND_* below instead of this override.
# VITE_TLB_INVITE_MAIL_ENDPOINT=https://your-server.example/send-staff-invite

# SSR / server mirrors (optional)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_sb_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# For Supabase Auth inviteUserByEmail use SERVICE_ROLE on a server only — never in the browser.

# Invite email (server-only on Vercel / Nitro — never VITE_*)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL="TLB Portal <invites@your-verified-domain.com>"

# Invite SMS — Termii preferred (server-only on Vercel / Nitro — never VITE_*)
# TERMII_API_KEY=your_termii_api_key
# TERMII_SENDER_ID=YourSenderID
# Optional: TERMII_BASE_URL=https://api.ng.termii.com
# Optional: TERMII_CHANNEL=dnd   (dnd for transactional; generic for promo)
# Twilio fallback (used only when TERMII_* is not set)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
